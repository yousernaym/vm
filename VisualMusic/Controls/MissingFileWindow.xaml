<mah:MetroWindow x:Class="VisualMusic.Controls.MissingFileWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Missing file"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 MinWidth="420"
                 WindowStartupLocation="CenterOwner"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="messageBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   FontSize="14"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Browse…" MinWidth="110" Margin="0,0,8,0" Click="Browse_Click"/>
                <Button Content="Search folder…" MinWidth="130" Click="SearchFolder_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ignore" MinWidth="86" Margin="0,0,8,0" Click="Ignore_Click"/>
                <Button Content="Abort" MinWidth="86" IsCancel="True" Click="Abort_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
